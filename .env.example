# Supabase 新项目的 URL 与浏览器可公开的 publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 仅后端使用，不能以 NEXT_PUBLIC_ 开头
SUPABASE_SECRET_KEY=
# 只允许这个 Supabase Auth 邮箱使用服务端接口
OWNER_EMAIL=
MINERU_API_TOKEN=
MINERU_API_BASE=https://mineru.net
MINERU_MODEL_VERSION=vlm
TTS_API_ENDPOINT=https://tts-voice-magic.pxmxmp1224.workers.dev/v1/audio/speech

# Vercel Cron 请求验证；使用足够长的随机字符串
CRON_SECRET=
# 自定义域名部署时填写，例如 https://reader.example.com；Vercel 默认域名可留空
MINERU_CALLBACK_BASE_URL=
